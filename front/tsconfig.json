{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".", // ← ADD THIS
    "paths": {
      "@/*": [
        "./*"
      ],
      "@types/*": [
        "../types/*"
      ] // ← ADD THIS FOR SHARED TYPES
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../types/**/*.ts", // ← ADD THIS LINE
    "../types/**/*.tsx" // ← ADD THIS LINE
  ]
}