# Copy to back/.env and fill in real values. Never commit back/.env.

# REQUIRED — server refuses to start without it (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# REQUIRED — Postgres connection for the app (database "bus", PostGIS enabled).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/bus

# Used only by init-db.cjs to create the "bus" database.
PG_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# REQUIRED — port the API listens on.
PORT=3000

# Comma-separated browser origins allowed via CORS (only the web build needs
# this; native apps are unaffected). Leave empty in production to disallow
# cross-origin browser calls entirely.
CORS_ALLOWED_ORIGINS=

# Set to 1 to expose Swagger (/docs) and sample/test routes in production.
ENABLE_DEV_API_TOOLING=

# --- Arabic NLP trip resolution ---
# Pattern/alias matching runs locally; the LLM pass is an optional fallback.
NLP_ENABLED=1
NLP_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OSRM ---
# Defaults point at public demo servers — replace with a self-hosted or paid
# instance before launch. Used for road snapping and walking geometry.
OSRM_BASE_URL=
OSRM_BUS_BASE_URL=
OSRM_FOOT_BASE_URL=
WALKING_GEOMETRY_OSRM_ENABLED=1
WALKING_GEOMETRY_OSRM_TIMEOUT_MS=5000

# --- Edge geometry backfill job ---
EDGE_GEOM_BACKFILL_BATCH_SIZE=100
EDGE_GEOM_BACKFILL_TIMEOUT_MS=10000
EDGE_GEOM_BACKFILL_MAX_RETRIES=3
EDGE_GEOM_BACKFILL_UPDATE_EXISTING=0
EDGE_GEOM_BACKFILL_RESET_CHECKPOINT=0

# Verbose A* / cost-model tracing.
DEBUG_ROUTING=0
