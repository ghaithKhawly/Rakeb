{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "rootDir": "..",  // ← CHANGE THIS LINE
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",  // ← ADD THIS
    "paths": {       // ← ADD THIS for clean imports
      "@types/*": ["../types/*"]
    }
  },
  "include": ["src/**/*", "../types/**/*"]
}